<div class="tab-pane fade" id="tabMatch" role="tabpanel" aria-labelledby="match-tab">
    <div class="d-flex align-items-center justify-content-between gap-2 mb-3">
        <div class="d-flex flex-wrap align-items-center gap-2">
            <div class="fw-bold" style="font-size:1.1rem;">Vagas sugeridas</div>
            <div id="profileJobMatchesUpdatedAt" class="small text-muted"></div>
        </div>
        <div class="d-flex align-items-center gap-2">
            <button type="button" class="btn btn-sm btn-outline-secondary profile-back-to-cards">
                <i class="bi bi-arrow-left me-1"></i> Voltar as secoes
            </button>
            <button class="btn btn-outline-primary btn-sm" type="button" id="profileRefreshMatchesBtn">
                <i class="bi bi-arrow-clockwise me-1"></i>Atualizar
            </button>
        </div>
    </div>

    <div class="small text-secondary mb-3">Sugestoes baseadas no seu perfil.</div>

    <div id="profileJobMatchesError" class="alert alert-warning d-none"></div>
    <div id="profileJobMatchesEmpty" class="alert alert-info d-none">
        Nao encontramos vagas sugeridas para o seu perfil.
    </div>
    <div id="profileJobMatchesList" class="d-none"></div>
</div>
